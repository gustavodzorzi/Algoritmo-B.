/*
 * Exercicio 1 - Cadastro simples de alunos
 *
 * Cria uma struct Aluno com nome, matricula e nota.
 * Le 5 alunos, armazena em um vetor de structs e exibe todos na tela.
 * Regra do exercicio: usar apenas funcoes SEM retorno (void).
 */

#include <stdio.h>
#include <string.h>

#define MAX_ALUNOS 5
#define TAM_NOME 50

typedef struct {
    char nome[TAM_NOME];
    int matricula;
    float nota;
} Aluno;

/* Le os dados de todos os alunos e preenche o vetor (passado por referencia) */
void lerAlunos(Aluno alunos[], int n) {
    for (int i = 0; i < n; i++) {
        printf("\n--- Aluno %d ---\n", i + 1);

        printf("Nome: ");
        /* le a linha inteira, incluindo espacos, e remove o '\n' final */
        fgets(alunos[i].nome, TAM_NOME, stdin);
        alunos[i].nome[strcspn(alunos[i].nome, "\n")] = '\0';

        printf("Matricula: ");
        scanf("%d", &alunos[i].matricula);

        printf("Nota: ");
        scanf("%f", &alunos[i].nota);

        getchar(); /* consome o '\n' deixado pelo scanf, para nao atrapalhar o proximo fgets */
    }
}

/* Exibe os dados de todos os alunos do vetor */
void exibirAlunos(Aluno alunos[], int n) {
    printf("\n===== LISTA DE ALUNOS =====\n");
    for (int i = 0; i < n; i++) {
        printf("Aluno %d\n", i + 1);
        printf("  Nome:      %s\n", alunos[i].nome);
        printf("  Matricula: %d\n", alunos[i].matricula);
        printf("  Nota:      %.2f\n", alunos[i].nota);
    }
}

int main(void) {
    Aluno alunos[MAX_ALUNOS];

    lerAlunos(alunos, MAX_ALUNOS);
    exibirAlunos(alunos, MAX_ALUNOS);

    return 0;
}

/*
 * Exercicio 2 - Media das notas
 *
 * A partir do exercicio 1, cria uma funcao COM retorno que recebe o vetor
 * de alunos e retorna a media geral das notas. O resultado e mostrado
 * no programa principal.
 */

#include <stdio.h>
#include <string.h>

#define MAX_ALUNOS 5
#define TAM_NOME 50

typedef struct {
    char nome[TAM_NOME];
    int matricula;
    float nota;
} Aluno;

/* void: le os dados de todos os alunos */
void lerAlunos(Aluno alunos[], int n) {
    for (int i = 0; i < n; i++) {
        printf("\n--- Aluno %d ---\n", i + 1);

        printf("Nome: ");
        fgets(alunos[i].nome, TAM_NOME, stdin);
        alunos[i].nome[strcspn(alunos[i].nome, "\n")] = '\0';

        printf("Matricula: ");
        scanf("%d", &alunos[i].matricula);

        printf("Nota: ");
        scanf("%f", &alunos[i].nota);

        getchar();
    }
}

/* void: exibe os dados de todos os alunos */
void exibirAlunos(Aluno alunos[], int n) {
    printf("\n===== LISTA DE ALUNOS =====\n");
    for (int i = 0; i < n; i++) {
        printf("Aluno %d - %s | Matricula: %d | Nota: %.2f\n",
               i + 1, alunos[i].nome, alunos[i].matricula, alunos[i].nota);
    }
}

/* COM retorno: recebe o vetor de alunos e devolve a media geral das notas */
float calcularMedia(Aluno alunos[], int n) {
    float soma = 0.0f;
    for (int i = 0; i < n; i++) {
        soma += alunos[i].nota;
    }
    return soma / n;
}

int main(void) {
    Aluno alunos[MAX_ALUNOS];

    lerAlunos(alunos, MAX_ALUNOS);
    exibirAlunos(alunos, MAX_ALUNOS);

    float media = calcularMedia(alunos, MAX_ALUNOS);
    printf("\nMedia geral da turma: %.2f\n", media);

    return 0;
}

/*
 * Exercicio 3 - Busca por matricula
 *
 * Funcao COM retorno que recebe o vetor de alunos e um numero de matricula
 * e retorna o indice do aluno (ou -1 se nao encontrado).
 * No main, o usuario digita uma matricula e o programa exibe os dados
 * do aluno correspondente.
 */

#include <stdio.h>
#include <string.h>

#define MAX_ALUNOS 5
#define TAM_NOME 50

typedef struct {
    char nome[TAM_NOME];
    int matricula;
    float nota;
} Aluno;

void lerAlunos(Aluno alunos[], int n) {
    for (int i = 0; i < n; i++) {
        printf("\n--- Aluno %d ---\n", i + 1);

        printf("Nome: ");
        fgets(alunos[i].nome, TAM_NOME, stdin);
        alunos[i].nome[strcspn(alunos[i].nome, "\n")] = '\0';

        printf("Matricula: ");
        scanf("%d", &alunos[i].matricula);

        printf("Nota: ");
        scanf("%f", &alunos[i].nota);

        getchar();
    }
}

void exibirAlunos(Aluno alunos[], int n) {
    printf("\n===== LISTA DE ALUNOS =====\n");
    for (int i = 0; i < n; i++) {
        printf("Aluno %d - %s | Matricula: %d | Nota: %.2f\n",
               i + 1, alunos[i].nome, alunos[i].matricula, alunos[i].nota);
    }
}

/* COM retorno: procura a matricula no vetor e devolve o indice, ou -1 */
int buscarPorMatricula(Aluno alunos[], int n, int matricula) {
    for (int i = 0; i < n; i++) {
        if (alunos[i].matricula == matricula) {
            return i;
        }
    }
    return -1;
}

int main(void) {
    Aluno alunos[MAX_ALUNOS];

    lerAlunos(alunos, MAX_ALUNOS);
    exibirAlunos(alunos, MAX_ALUNOS);

    int matriculaBuscada;
    printf("\nDigite a matricula que deseja buscar: ");
    scanf("%d", &matriculaBuscada);

    int indice = buscarPorMatricula(alunos, MAX_ALUNOS, matriculaBuscada);

    if (indice != -1) {
        printf("\nAluno encontrado!\n");
        printf("Nome:      %s\n", alunos[indice].nome);
        printf("Matricula: %d\n", alunos[indice].matricula);
        printf("Nota:      %.2f\n", alunos[indice].nota);
    } else {
        printf("\nNenhum aluno encontrado com a matricula %d.\n", matriculaBuscada);
    }

    return 0;
}

