#include <cstring>
#include <ctype.h>
#include <iostream>
#include <stdlib.h>
#include <string>
#include <time.h>
#include <vector>
#include <fstream>
using namespace std;

typedef struct {
    string numeroCelular;
    string dadosSessao;
} Telefone;

// split do professor (new[] no lugar de malloc; liberar com delete[])
string *split(string frase, string delimitador = " ")
{
    string *vetor = new string[3];
    int inicio = 0;
    int fim = frase.find(delimitador);
    int i = 0;
    while (fim != -1 && i < 2) {
        vetor[i] = frase.substr(inicio, fim - inicio);
        inicio = fim + delimitador.size();
        fim = frase.find(delimitador, inicio);
        i++;
    }
    vetor[i] = frase.substr(inicio);

    return vetor;
}

void carregarBase(string nomeArquivo, vector<Telefone>& listaSessoes) {
    ifstream arquivo(nomeArquivo);

    if (!arquivo) {
        cout << "Erro: nao foi possivel abrir '" << nomeArquivo << "'\n";
        return;
    }

    listaSessoes.clear();
    string linha;

    while (getline(arquivo, linha)) {
        if (!linha.empty() && linha.back() == '\r') linha.pop_back();
        if (linha.empty()) continue;

        string *partes = split(linha, ";");
        Telefone t;
        t.numeroCelular = partes[0];
        t.dadosSessao = partes[1];
        delete[] partes;

        listaSessoes.push_back(t);
    }

    arquivo.close();
}

void listar(const vector<Telefone>& listaSessoes) {
    if (listaSessoes.empty()) {
        cout << "Nenhum numero cadastrado.\n";
        return;
    }

    cout << "\nNumeros cadastrados:\n";
    for (int i = 0; i < listaSessoes.size(); i++) {
        cout << listaSessoes[i].numeroCelular << "\n";
    }
    cout << "\nQuantidade: " << listaSessoes.size() << "\n";
}

void pesquisar(const vector<Telefone>& listaSessoes) {
    string numeroPesquisa;

    cout << "Digite o numero que deseja pesquisar: ";
    getline(cin, numeroPesquisa);

    bool encontrado = false;
    for (int i = 0; i < listaSessoes.size(); i++) {
        if (numeroPesquisa == listaSessoes[i].numeroCelular) {
            cout << "\nNumero encontrado: " << listaSessoes[i].numeroCelular
                 << "\nDados da sessao: " << listaSessoes[i].dadosSessao << "\n";
            encontrado = true;
        }
    }

    if (!encontrado) {
        cout << "Numero nao encontrado.\n";
    }
}

int main() {
    vector<Telefone> listaSessoes;
    int opcao;
    string arquivoBase = "telephony_sessions.txt";

    carregarBase(arquivoBase, listaSessoes);   // carrega uma unica vez

    do {
        cout << "\nMENU\n";
        cout << "1 - Listar telefones\n";
        cout << "2 - Pesquisar telefone e dados de sessao\n";
        cout << "3 - Finalizar\n";
        cout << "Opcao: ";
        if (!(cin >> opcao)) {          // evita loop infinito se digitar letra
            cin.clear();
            opcao = 0;
        }
        cin.ignore(10000, '\n');

        switch (opcao) {
            case 1:
                listar(listaSessoes);
                break;
            case 2:
                pesquisar(listaSessoes);
                break;
            case 3:
                cout << "Obrigado por usar o sistema\n";
                break;
            default:
                cout << "Opcao invalida!\n";
                break;
        }
    } while (opcao != 3);

    return 0;
}
